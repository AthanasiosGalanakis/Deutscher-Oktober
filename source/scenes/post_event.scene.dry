title: Post Event
new-page: true
on-arrival: {!
// Runs after every card, advisor action and event, and once at the start.
// Advances the month when an action was taken, then recomputes the
// party: members, faction strength, the party line and the meters.
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// The systems library (RG helpers): load it if this page has not, or if it
// belongs to another engine (a reload, a loaded game, a language switch).
if ((typeof RG === 'undefined' || RG.engine !== this) && this.game.scenes.sys_lib) {
    this._runActions(this.game.scenes.sys_lib.onArrival);
}
var sys = (typeof RG !== 'undefined') ? RG : null;

// Run every writer's setup scene (file id ending in _init) once, silently,
// so the setup never shows up as an event the player has to click.
for (var sid in this.game.scenes) {
    if (/_init$/.test(sid) && !Q[sid + '_ran'] && this.game.scenes[sid].onArrival) {
        Q[sid + '_ran'] = 1;
        this._runActions(this.game.scenes[sid].onArrival);
    }
}

var clamp = function(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); };

// ---------------------------------------------------------------- time
// Normal play advances one month per action. During a crisis (crisis = 1)
// each action is one week; after the 4th week the month turns as usual.
var month_turns = false;
var congress_acted = false;
if (!Q.crisis) {
    Q.week = 0;
}
if (Q.month_actions >= 1) {
    Q.month_actions = 0;
    if (Q.congress) {
        // A congress fills its month: each action is one session, and the
        // month turns when the closing event ends the congress.
        congress_acted = true;
    } else if (Q.crisis) {
        Q.crisis_time += 1;
        Q.week += 1;
        if (Q.week > 4) {
            Q.week = 1;
            month_turns = true;
        }
    } else {
        Q.week = 0;
        month_turns = true;
    }
}
if (month_turns) {
    Q.faction_shift_note = 0;
    Q.time += 1;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
    }
    for (var timer of Q.timers) {
        if (Q[timer + '_timer'] && Q[timer + '_timer'] > 0) {
            Q[timer + '_timer'] -= 1;
        }
    }
    if (Q.advisor_action_timer > 0) {
        Q.advisor_action_timer -= 1;
    }
    Q.resources += Q.moscow_subsidy;
    // Monthly drift. Militancy draws repression, and repression thins out
    // the districts: both now happen district by district (sys_lib,
    // districtMonthly), and the national meters are their summaries.
    if (!sys) {
        Q.repression += Q.militancy / 20 - 2;
        if (Q.repression >= 60) {
            for (var d of Q.districts) {
                Q['district_' + d + '_members'] *= 0.98;
            }
        }
    }
    // Inflation: slow until 1922, then runaway.
    Q.inflation += (Q.year >= 1922) ? 3 : 0.5;
    // Unity drifts towards the strength-weighted satisfaction of the factions.
    Q.unity += (Q.unity_target - Q.unity) * 0.25;
    // Lean: every option that follows a faction's line adds to lean_<faction>.
    // It is added to history_<faction> for good (the historical splits read
    // these), and a strong lean wins over a wavering district.
    var top = null;
    for (var f of Q.factions) {
        Q['history_' + f] += Q['lean_' + f];
        if (!Q[f + '_gone'] && Q['lean_' + f] >= 4 && (!top || Q['lean_' + f] > Q['lean_' + top])) {
            top = f;
        }
    }
    if (top && Math.random() < 0.35) {
        var cands = Q.districts.filter(function(d) {
            return Q['district_' + d + '_faction'] != top && Q['district_' + d + '_loyalty'] < 60;
        });
        if (cands.length) {
            var pick = cands[Math.floor(Math.random() * cands.length)];
            Q['district_' + pick + '_faction'] = top;
            Q.faction_shift_note = Q.district_names[pick] + ' now follows the ' + Q.faction_names[top] + '.';
        }
    }
    for (var f of Q.factions) {
        Q['lean_' + f] = 0;
    }
    // Hostile districts may act on their own (not during a crisis week).
    Q.defiance_flag = 0;
    for (var d of Q.districts) {
        var f = Q['district_' + d + '_faction'];
        if (f != Q.leading_faction && Q['district_' + d + '_loyalty'] < 30 && Math.random() < 0.15) {
            Q.defiant_district = d;
            Q.defiance_flag = 1;
            Q.defiant_district_name = Q.district_names[d];
            Q.defiant_faction_name = Q.faction_names[f];
            break;
        }
    }
}

// ---------------------------------------------------------------- systems
// districts' life, the comrades, Moscow's Executive and its directives,
// congress sessions and the ledger (see sys_lib)
if (sys) {
    sys.everyTurn(month_turns, congress_acted);
}

// ---------------------------------------------------------------- districts
var total_members = 0;
var faction_members = {};
for (var f of Q.factions) {
    faction_members[f] = 0;
}
Q.loyal_members = 0;
for (var d of Q.districts) {
    Q['district_' + d + '_loyalty'] = clamp(Q['district_' + d + '_loyalty'], 0, 100);
    if (Q['district_' + d + '_members'] < 0.1) {
        Q['district_' + d + '_members'] = 0.1;
    }
    var m = Q['district_' + d + '_members'];
    var df = Q['district_' + d + '_faction'];
    total_members += m;
    faction_members[df] += m;
    if (Q['district_' + d + '_loyalty'] >= 50) {
        Q.loyal_members += m;
    }
    Q['district_' + d + '_faction_name'] = Q.faction_names[df];
    Q['district_' + d + '_members_display'] = m.toFixed(1);
}
Q.members = total_members;
Q.members_display = total_members.toFixed(1);
// share of members in districts loyal to the Zentrale; scales card effects
Q.loyal_share = total_members > 0 ? Q.loyal_members / total_members : 0;
Q.loyal_share_display = Math.round(100 * Q.loyal_share);

// ---------------------------------------------------------------- factions
var weighted = 0;
for (var f of Q.factions) {
    Q[f + '_strength'] = total_members > 0 ? 100 * faction_members[f] / total_members : 0;
    Q[f + '_satisfaction'] = clamp(Q[f + '_satisfaction'], 0, 100);
    weighted += Q[f + '_strength'] * Q[f + '_satisfaction'];
}
Q.unity_target = weighted / 100;

// A faction pushed below 10 satisfaction while holding members splits off.
Q.split_flag = 0;
for (var f of Q.factions) {
    if (f != Q.leading_faction && !Q[f + '_gone'] && Q[f + '_satisfaction'] < 10 && Q[f + '_strength'] >= 5) {
        Q.split_faction = f;
        Q.split_flag = 1;
        Q.split_faction_name = Q.faction_names[f];
        break;
    }
}

// ---------------------------------------------------------------- party line
// Each faction's line: 0 = open, 1 = soft lock (costs Unity), 2 = hard lock.
var lines = {
    luxemburgist: {elections: 0, united_front: 0, union_work: 0, councils: 0, uprising: 1, moscow_orders: 1},
    offensive:    {elections: 0, united_front: 2, union_work: 1, councils: 0, uprising: 0, moscow_orders: 0},
    unionist:     {elections: 0, united_front: 0, union_work: 0, councils: 0, uprising: 1, moscow_orders: 0},
    ultraleft:    {elections: 2, united_front: 2, union_work: 2, councils: 0, uprising: 0, moscow_orders: 1}
};
var lead = lines[Q.leading_faction];
var junior = Q.junior_faction ? lines[Q.junior_faction] : null;
for (var action of Q.line_actions) {
    var lock = lead[action];
    // A junior partner's red lines become soft locks.
    if (junior && lock == 0 && junior[action] == 2) {
        lock = 1;
    }
    Q['lock_' + action] = lock;
}
Q.leading_faction_name = Q.faction_names[Q.leading_faction];
Q.leading_faction_adj = Q.faction_adj[Q.leading_faction];
Q.junior_faction_name = Q.junior_faction ? Q.faction_names[Q.junior_faction] : 0;

// ---------------------------------------------------------------- meters
Q.unity = clamp(Q.unity, 0, 100);
Q.militancy = clamp(Q.militancy, 0, 100);
Q.worker_support = clamp(Q.worker_support, 0, 100);
Q.repression = clamp(Q.repression, 0, 100);
for (var p of Q.parties) {
    Q[p + '_relation'] = clamp(Q[p + '_relation'], 0, 100);
}
Q.crisis_momentum = clamp(Q.crisis_momentum, 0, 100);
Q.inflation = Math.max(0, Q.inflation);
Q.government_seats = 0;
for (var p of Q.parties) {
    if (Q[p + '_in_government']) {
        Q.government_seats += Q[p + '_seats'];
    }
}
// forces, shown in the Forces tab
for (var fo of Q.forces) {
    if (Q[fo + '_strength'] < 0) {
        Q[fo + '_strength'] = 0;
    }
    Q[fo + '_strength_display'] = Math.round(Q[fo + '_strength']);
    Q[fo + '_loyalty'] = clamp(Q[fo + '_loyalty'], 0, 100);
}
Q.independence = clamp(Q.independence, 0, 100);
Q.world_revolution = clamp(Q.world_revolution, 0, 100);
Q.stability = clamp(Q.stability, 0, 100);
if (Q.resources < 0) {
    Q.resources = 0;
}
Q.unity_display = Math.round(Q.unity);
// the party's name: VKPD from the December 1920 unification until the
// 1921 writer's Jena congress switches back to KPD
Q.party_name = (Q.vkpd_formed && Q.e21_party != 'KPD' && Q.year <= 1921) ? 'VKPD' : 'KPD';

// ---------------------------------------------------------------- sidebar lines
// short summaries the sidebar shows instead of long tables
(function () {
    var surname = function (n) { var w = String(n).split(' '); return w[w.length - 1]; };
    var order = {
        luxemburgist: ['luxemburg', 'liebknecht', 'levi', 'zetkin', 'meyer', 'pieck', 'eberlein', 'jogiches', 'levine'],
        offensive: ['fischer', 'thalmann', 'maslow', 'frolich', 'munzenberg', 'hoelz'],
        unionist: ['brandler', 'thalheimer', 'walcher'],
        ultraleft: ['ruhle', 'laufenberg', 'wolffheim', 'schroder']
    };
    var roster = Array.isArray(Q.comrades) ? Q.comrades : [];
    var byId = {};
    roster.forEach(function (c) { byId[c.id] = c; });
    ['luxemburgist', 'offensive', 'unionist', 'ultraleft'].forEach(function (f) {
        var names = [];
        roster.forEach(function (c) {
            if (c.faction == f && (c.status == 'free' || c.status == 'prison') && names.length < 3) {
                names.push(c);
            }
        });
        names.sort(function (a, b) {
            var o = order[f] || [];
            var ia = o.indexOf(a.id), ib = o.indexOf(b.id);
            return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
        });
        Q['sb_leaders_' + f] = names.length ? names.map(function (c) {
            return surname(c.name) + (c.status == 'prison' ? ' (in prison)' : '');
        }).join(', ') : 0;
    });
    var dnames = {berlin: 'Berlin', hamburg: 'Hamburg', bremen: 'Bremen', ruhr: 'the Ruhr', saxony: 'Saxony',
        thuringia: 'Thuringia', bavaria: 'Bavaria', halle: 'Halle'};
    var strikes = (Q.districts || []).filter(function (d) { return Q['district_' + d + '_strike']; });
    Q.sb_strikes = strikes.length ? strikes.map(function (d) { return dnames[d] || d; }).join(', ') : 0;
    var ecci = [['lenin', 'Lenin'], ['zinoviev', 'Zinoviev'], ['radek', 'Radek'], ['trotsky', 'Trotsky'], ['bukharin', 'Bukharin']];
    var friends = [], critics = [];
    ecci.forEach(function (e) {
        var v = Q['ecci_' + e[0]];
        if (typeof v != 'number') { return; }
        if (v >= 60) { friends.push(e[1]); }
        if (v < 40) { critics.push(e[1]); }
    });
    Q.sb_friends = friends.length ? friends.join(', ') : 0;
    Q.sb_critics = critics.length ? critics.join(', ') : 0;
    var lines = [['elections', 'elections'], ['united_front', 'the united front'], ['union_work', 'union work'],
        ['councils', 'councils and occupations'], ['uprising', 'armed uprising'], ['moscow_orders', 'Moscow\'s orders']];
    var forbidden = [], against = [];
    lines.forEach(function (l) {
        var v = Q['lock_' + l[0]];
        if (v == 2) { forbidden.push(l[1]); }
        if (v == 1) { against.push(l[1]); }
    });
    var cap = function (t) { return t.charAt(0).toUpperCase() + t.slice(1); };
    Q.sb_forbidden = forbidden.length ? cap(forbidden.join(', ')) : 0;
    Q.sb_against = against.length ? cap(against.join(', ')) : 0;
})();

if (sys) {
    sys.finishTurn(month_turns);
}

if (typeof document !== 'undefined') {
    document.body.classList.toggle('crisis-mode', !!Q.crisis);
    document.body.classList.toggle('congress-mode', !!Q.congress);
}

// ---------------------------------------------------------------- routing
Q.has_event = 0;
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
// A congress whose own closing event cannot fire is closed by the generic one.
if (!Q.has_event && Q.congress && Q.congress_closing) {
    Q.congress_own_close = 0;
    choices = this._compileChoices(scene);
    if (choices && choices[0].title != "Continue...") {
        Q.has_event = 1;
    }
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0

= [+ month : month +] [+ year +][? if crisis : , week [+ week +] ?]

@events_choice

- #event
