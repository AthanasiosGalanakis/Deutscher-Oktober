title: Game Over.
new-page: true
on-arrival: game_over = 1
go-to: verdict

@verdict
new-page: true
on-arrival: {!
if (!Q.ending_id) { Q.ending_id = 6; }
var E = Q.ending_id;
var L = {unionist: 'Heinrich Brandler', offensive: 'Ruth Fischer', luxemburgist: (Q.luxemburg_alive == 1 ? 'Rosa Luxemburg' : (Q.levi_in_party == 1 ? 'Paul Levi' : 'Ernst Meyer')), ultraleft: 'Karl Schröder'};
Q.party_leader = L[Q.leading_faction] || 'the Zentrale';
Q.go_lead = RG.CODE[Q.leading_faction] || 3;
var m = Q.members || 0;
Q.go_size = m < 30 ? 1 : (m < 120 ? 2 : (m < 250 ? 3 : 4));
Q.go_support = Q.worker_support < 20 ? 1 : (Q.worker_support < 40 ? 2 : (Q.worker_support < 60 ? 3 : 4));
Q.go_indep = Q.independence < 30 ? 1 : (Q.independence < 60 ? 2 : 3);
Q.go_unity = Q.unity < 35 ? 1 : (Q.unity < 65 ? 2 : 3);
Q.go_region = Q.e23_red_region > 0 ? Q.e23_red_region : (Q.ruhr_red_army == 2 ? 2 : (Q.bavaria_soviet == 2 ? 4 : (Q.march_action == 2 ? 5 : 0)));
Q.go_dict = Q.kapp_outcome == 2 ? 1 : (Q.e23_directory == 1 ? 2 : 3);
Q.go_germany = Q.e22_workers_gov > 0 ? 1 : (Q.stability >= 35 ? 2 : 3);
Q.go_spd = Q.spd_relation >= 40 ? 1 : 0;
Q.go_right = Q.sa_strength >= 10 ? 1 : 0;
Q.go_people = (E == 6 || E == 2) ? 1 : 0;
Q.go_exile = (E == 3 || E == 4) ? 1 : 0;
Q.go_thaelmann_rise = (Q.go_lead == 2 || Q.e23_reckoning == 2 || Q.e23_reckoning == 4) ? 1 : 0;
var esc = function (t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };
var lst = function (n) { return n.length <= 1 ? n.join('') : n.slice(0, -1).join(', ') + ' and ' + n[n.length - 1]; };
var dn = Q.district_names || {};

// what the party did in its last two years, in the order it happened
var s = [];
if (Q.e22_rathenau_front == 1) { s.push('When Rathenau was shot, the party signed the joint programme with the SPD and the unions.'); }
if (Q.e22_rathenau_front == 2) { s.push('When Rathenau was shot, the party called a general strike of its own.'); }
if (Q.e22_rathenau_front == 3) { s.push('When Rathenau was shot, the party formed defence squads in every district.'); }
if (Q.e22_workers_gov == 1) { s.push('Its votes kept a workers\' government in office when Cuno could have had it.'); }
if (Q.e22_workers_gov == 2) { s.push('Its ministers sat in a workers\' government of the Reich.'); }
if (Q.e23_cuno_result == 1) { s.push('In August its strike brought down Cuno, with the strikers still on their feet.'); }
if (Q.e23_cuno_result == 2) { s.push('In August its strike brought down Cuno, and the strikers went back to work exhausted.'); }
if (Q.e23_cuno_result == 3) { s.push('In August its strike against Cuno broke before he did.'); }
if (Q.e23_october_refused == 1) { s.push('It refused Moscow\'s plan for an October.'); }
var focus = {1: 'Saxony and Thuringia', 2: 'Berlin', 3: 'the Ruhr and the ports'}[Q.e23_oct_focus];
var rose = 'When it rose, ' + (focus ? 'it put its reserves into ' + focus + ', and ' : '');
if (Q.german_october == 3) { s.push(rose + 'the councils took Berlin.'); }
else if (Q.german_october == 2 && Q.e23_oct_result == 2 && Q.e23_red_names) { s.push(rose + 'the councils held ' + Q.e23_red_names + '.'); }
else if (Q.german_october == 2) { s.push(rose + 'the Reichswehr beat it.'); }
else if (Q.german_october == 1) { s.push('Its October was called off at Chemnitz, and Hamburg fought alone.'); }
else if (Q.e23_october_done == 1 && Q.e23_october_refused != 1) { s.push('Its October was called off before a shot was fired.'); }
if (Q.e23_reckoning == 1) { s.push('In December the Central Committee kept Brandler.'); }
if (Q.e23_reckoning == 2) { s.push('In December the Central Committee gave the party to the Left.'); }
if (Q.e23_reckoning == 3) { s.push('In December a middle group took the Zentrale.'); }
if (Q.e23_reckoning == 4) { s.push('In December the Left took the party and expelled Brandler.'); }
Q.go_story = s.join(' ');
Q.go_has_story = s.length ? 1 : 0;

// the party's record: the ledger as a list
var led = Array.isArray(Q.ledger) ? Q.ledger.filter(function (x) { return typeof x === 'string' && x; }) : [];
Q.go_has_record = led.length ? 1 : 0;
Q.go_record_html = led.length ? '<ul class="party-record">' + led.map(function (x) {
    var i = x.indexOf(': ');
    return i > 0 ? '<li><strong>' + esc(x.slice(0, i)) + '</strong>: ' + esc(x.slice(i + 2)) + '</li>' : '<li>' + esc(x) + '</li>';
}).join('') + '</ul>' : '';

// Moscow
var fav = Q.moscow_favour || 0;
Q.go_msk = Q.comintern_member != 1 ? 0 : (fav < 30 ? 1 : (fav < 60 ? 2 : 3));
var fr = ['zinoviev', 'radek', 'trotsky', 'bukharin'].concat(Q.ecci_lenin_ill ? [] : ['lenin']);
fr.sort(function (a, b) { return (Q['ecci_' + b] || 0) - (Q['ecci_' + a] || 0); });
Q.go_friend = {lenin: 'Lenin', zinoviev: 'Zinoviev', radek: 'Radek', trotsky: 'Trotsky', bukharin: 'Bukharin'}[fr[0]];
Q.go_backs_other = (Q.moscow_backs && Q.moscow_backs != Q.leading_faction && !Q[Q.moscow_backs + '_gone']) ? 1 : 0;
Q.go_backs_name = Q.moscow_backs_name || 0;
Q.go_dir_defied = Q.directives_defied || 0;

// the map
var ds = (Q.districts || []).slice();
var hold = ds.filter(function (d) { return Q['district_' + d + '_loyalty'] >= 55 && Q['district_' + d + '_members'] >= 8; });
hold.sort(function (a, b) { return Q['district_' + b + '_members'] - Q['district_' + a + '_members']; });
var broken = ds.filter(function (d) { return Q['district_' + d + '_repression'] >= 80 && hold.indexOf(d) < 0; });
var armed = ds.filter(function (d) { return Q['district_' + d + '_guards'] >= 4; });
var names = function (arr) { return lst(arr.map(function (d) { return dn[d] || d; })); };
Q.go_hold = names(hold.slice(0, 3)); Q.go_has_hold = hold.length ? 1 : 0;
Q.go_broken = names(broken); Q.go_has_broken = (broken.length && broken.length < 5) ? 1 : 0;
Q.go_broken_many = broken.length >= 5 ? 1 : 0;
Q.go_armed = names(armed); Q.go_has_armed = armed.length ? 1 : 0;
var biggest = ds.slice().sort(function (a, b) { return Q['district_' + b + '_members'] - Q['district_' + a + '_members']; })[0];
Q.go_biggest = dn[biggest] || biggest;

// the comrades
var roster = Array.isArray(Q.comrades) ? Q.comrades.filter(function (c) { return c.faction != 'ecci' && c.status != 'outside'; }) : [];
var by = function (st) { return roster.filter(function (c) { return c.status == st; }).map(function (c) { return c.name; }); };
var pr = by('prison'), ex = by('exile'), de = by('dead'), xp = by('expelled');
Q.go_c_prison = lst(pr); Q.go_c_has_prison = pr.length ? 1 : 0;
Q.go_c_exile = lst(ex); Q.go_c_has_exile = ex.length ? 1 : 0;
Q.go_c_dead = lst(de); Q.go_c_has_dead = de.length ? 1 : 0;
Q.go_c_expelled = lst(xp); Q.go_c_has_expelled = xp.length ? 1 : 0;
var st = function (id) { return Q['comrade_' + id] || 0; };
Q.go_brandler = st('brandler'); Q.go_fischer = st('fischer'); Q.go_thalmann = st('thalmann');

// the last front page of an ordinary end
var score = (Q.members || 0) / 6 + (Q.worker_support || 0) * 0.8 + (Q.unity || 0) * 0.3 + hold.length * 4 - broken.length * 4 - (Q.kpd_banned == 1 ? 10 : 0);
Q.go_grade = E != 6 ? 0 : (score < 25 ? 1 : (score < 45 ? 2 : (score < 65 ? 3 : 4)));
!}

= Game Over

[? if ending_id = 1 : **The German Soviet Republic** ?][? if ending_id = 2 : **A Red Island** ?][? if ending_id = 3 : **The Generals** ?][? if ending_id = 4 : **Order Prevails** ?][? if ending_id = 5 : **One Party of the Workers** ?][? if ending_id = 6 : **New Year 1924** ?]

[? if ending_id = 1 : The congress of workers' and soldiers' councils meets in the Reichstag, in the chamber where the war credits were voted in 1914. It proclaims the German Socialist Soviet Republic on its first afternoon. [+ party_leader +] sits on its executive between a left Social Democrat from Leipzig and a corporal from Spandau. ?]

[? if ending_id = 1 : The first decrees take the mines, the banks and the steelworks of the Ruhr into public hands and give the East Elbian estates to the labourers who work them. Seeckt's officers hold out in East Prussia for the winter. Poincaré threatens to march on Frankfurt and changes his mind when the French railwaymen say they will not move the trains. ?]

[? if ending_id = 1 : In Moscow the news is read out at a session of the Politburo. Zinoviev wants to move the Executive of the International to Berlin. Stalin asks how much grain the Germans will send. ?][? if ending_id = 1 and luxemburg_alive = 1 : Rosa Luxemburg's first speech to the congress is about the freedom of the press, and half the platform does not applaud. ?][? if ending_id = 1 and liebknecht_alive = 1 : Karl Liebknecht reads the proclamation from the balcony of the Palace, where he stood on 9 November 1918. ?]

[? if ending_id = 2 and go_region = 1 : The councils govern Saxony and Thuringia from Chemnitz. The hundreds hold the passes of the Erzgebirge and the Thuringian Forest, and the Reichswehr has dug in along the Saale. ?][? if ending_id = 2 and go_region = 2 : The councils govern the Ruhr from Bochum town hall. The French army is on one side of them and the Reichswehr on the other, and both buy coal from the councils. ?][? if ending_id = 2 and go_region = 3 : The councils govern Hamburg and Bremen. The harbour is closed to the army, and Soviet freighters unload grain at the Kaiserkai. ?][? if ending_id = 2 and go_region = 4 : The Bavarian council republic has lived through another winter, poor and blockaded, the only one west of the Vistula. ?][? if ending_id = 2 and go_region = 5 : The councils that won the March fighting hold Leuna and the Mansfeld pits, and Berlin sends negotiators to Halle every month. ?][? if ending_id = 2 and go_region = 0 : The councils still rule one corner of the Reich. ?]

[? if ending_id = 2 : The rest of Germany is governed from Berlin, which sends spies and a blockade. Moscow sends advisers and rifles. [+ party_leader +] chairs the council executive, and the party argues every week about whether to wait for the next wave or to go out and start it. ?]

[? if ending_id = 3 and go_dict = 1 : The Kapp putsch of March 1920 lasted. Kapp himself was soon pushed aside, but the generals who stood behind him stayed, and they govern with a civilian chancellor for the photographs. The Weimar constitution was suspended in 1920 and has not been restored. ?][? if ending_id = 3 and go_dict = 2 : Seeckt kept the emergency powers of November 1923. His Directory governs by decree with Krupp's directors and the Bavarian monarchists, and the Reichstag building is closed. ?][? if ending_id = 3 and go_dict = 3 : The generals took power, and the Republic fell without a fight. ?]

[? if ending_id = 3 : The party is illegal. Its members meet in cells of five, print on hand presses and wait. The Social Democrats are banned a few months after us. ?][? if ending_id = 3 and e23_dir_choice = 2 : The Zentrale sits in Prague and sends its instructions by courier over the mountains. ?]

[? if ending_id = 4 : A few hundred members are left, and they do not know each other's addresses. The workers who followed the party in 1919 and in 1923 go back to the SPD, to the unions or to nothing. The employers have their long working day again. In Munich the men in brown shirts say they will finish what the Reichswehr started. ?]

[? if ending_id = 5 : The Communist Party of Germany has merged into a single workers' party with the Social Democrats, and its delegates hold a third of the seats on the new executive. Moscow expelled every one of them from the International by telegram. The new party is the largest in the Reich, and its congresses last a week because nobody will stop arguing about the Reichswehr and the coalition. ?][? if ending_id = 5 and luxemburg_alive = 1 : Rosa Luxemburg, who left the SPD in 1917, sits on its executive again and edits its theoretical journal. ?][? if ending_id = 5 and levi_in_party = 1 : Paul Levi, who argued for unity longer than anyone, speaks for the united party in the Reichstag. ?]

[? if ending_id = 6 and go_size = 1 : The party goes into 1924 as a sect, small and worn out. ?][? if ending_id = 6 and go_size = 2 : The party goes into 1924 smaller than it hoped, with a hard core that has been through everything. ?][? if ending_id = 6 and go_size = 3 : The party goes into 1924 as a mass party, the largest communist party outside Russia. ?][? if ending_id = 6 and go_size = 4 : The party goes into 1924 as a great mass party, with more members than any communist party in the world outside Russia. ?] [? if ending_id = 6 and go_support >= 3 : Its candidates win the factory council elections in the big works of Berlin, Saxony and the Ruhr. ?][? if ending_id = 6 and go_support = 2 : It is followed in the worst-paid trades and at the labour exchanges. ?][? if ending_id = 6 and go_support = 1 : Most workers will not listen to it, and many blame it for the year of hunger. ?]

[? if ending_id = 6 and go_lead = 1 : The Spartacists hold the Zentrale under [+ party_leader +]. ?][? if ending_id = 6 and go_lead = 2 : Ruth Fischer, Arkadi Maslow and Ernst Thälmann hold the Zentrale, and they promise that the next October will not be called off. ?][? if ending_id = 6 and go_lead = 3 : Heinrich Brandler holds the Zentrale, and the party is betting on the united front and the unions. ?][? if ending_id = 6 and go_lead = 4 : The council communists hold the Zentrale, and the party has left the unions and the parliaments to others. ?] [? if ending_id = 6 and go_unity = 1 : The next split is already being organised. ?][? if ending_id = 6 and go_unity = 3 : For once, its currents are working together. ?] [? if ending_id = 6 and go_indep = 1 : Its money, its line and more and more of its leaders come from Moscow. ?][? if ending_id = 6 and go_indep = 3 : Zinoviev calls it the most troublesome section of the International. ?]

[? if ending_id = 6 and go_germany = 1 : The workers' government born in the Kapp days is still in office, poor and harassed by the generals. ?][? if ending_id = 6 and go_germany = 2 : The Rentenmark holds, the Americans are drafting a plan for the reparations, and the bourgeois parties govern with the SPD's toleration. ?][? if ending_id = 6 and go_germany = 3 : The Republic is governed by emergency decree, and the army holds the real power. ?] [? if ending_id = 6 and go_spd = 1 : The SPD and the party are on speaking terms. ?][? if ending_id = 6 and go_spd = 0 : The SPD and the party are not on speaking terms. ?] [? if ending_id = 6 and go_right = 1 : Hitler is in Landsberg prison, writing a book, and his men are still on the streets. ?]

[? if go_has_story = 1 : **What the party did.** [+ go_story +] ?]

[? if go_people = 1 and go_brandler = 5 : Heinrich Brandler, expelled, builds a small opposition among the union men of Saxony. ?][? if go_people = 1 and go_brandler = 3 : Heinrich Brandler lives in a room at the Hotel Lux in Moscow, with no work to do. ?][? if go_people = 1 and go_brandler = 2 : Heinrich Brandler is in a cell in Leipzig, waiting for the State Court. ?][? if go_people = 1 and go_brandler = 4 : Heinrich Brandler did not live to see 1924. ?] [? if go_people = 1 and go_fischer = 2 : Ruth Fischer is in prison, which does her no harm with the Left. ?][? if go_people = 1 and go_fischer = 3 : Ruth Fischer writes for the party from abroad. ?][? if go_people = 1 and go_fischer = 1 and go_lead = 2 : Ruth Fischer, twenty-eight years old, leads the party. Within three years Moscow will expel her. ?] [? if go_people = 1 and go_thalmann = 4 : Ernst Thälmann was killed in 1923, and the Hamburg dockers have named a hall after him. ?][? if go_people = 1 and go_thalmann = 2 : Ernst Thälmann is in prison in Hamburg, and the dockers collect for his family every Friday. ?][? if go_people = 1 and go_thalmann = 1 and go_thaelmann_rise = 1 : Ernst Thälmann is the coming man of the Left. Within two years he will chair the party, and in 1944 the National Socialists will shoot him in Buchenwald. ?]

[? if go_exile = 1 and luxemburg_alive = 1 : Rosa Luxemburg is smuggled into Switzerland, where she writes a history of the German revolution and refuses every invitation to Moscow. ?][? if go_exile = 1 and liebknecht_alive = 1 : Karl Liebknecht is sentenced to fifteen years in a fortress. ?][? if go_exile = 1 : Brandler and Fischer meet again in Moscow and blame each other in front of Zinoviev. ?]

[? if go_msk = 1 : The Executive in Moscow has written the German party off as a problem, and its letters bring instructions. ?][? if go_msk = 2 : The Executive in Moscow pays the German party's bills, most months, and does not trust it. ?][? if go_msk = 3 : The Executive in Moscow counts the German party among its best sections. ?][? if go_msk > 0 : Its best friend there is [+ go_friend +]. ?][? if go_msk > 0 and go_backs_other = 1 : Moscow would rather see the [+ go_backs_name +] in the Zentrale. ?][? if go_msk > 0 and go_dir_defied >= 1 : Every directive the party refused is in a file in the Mokhovaya. ?][? if go_msk = 0 : The party is outside the International. ?]

[? if ending_id = 2 : The party's largest district is [+ go_biggest +]. ?][? if ending_id = 6 : The party's largest district is [+ go_biggest +]. ?][? if go_has_hold = 1 and ending_id != 1 and ending_id != 4 : It is strongest in [+ go_hold +]. ?][? if go_has_armed = 1 and ending_id != 1 and ending_id != 4 : In [+ go_armed +] there are still rifles under the floorboards. ?][? if go_has_broken = 1 and ending_id != 1 and ending_id != 4 : In [+ go_broken +] the offices are sealed and the secretaries are in prison. ?][? if go_broken_many = 1 and ending_id != 1 and ending_id != 4 : In most districts the offices are sealed and the secretaries are in prison. ?]

[? if go_c_has_prison = 1 : In prison: [+ go_c_prison +]. ?][? if go_c_has_exile = 1 : Abroad: [+ go_c_exile +]. ?][? if go_c_has_dead = 1 : Dead: [+ go_c_dead +]. ?][? if go_c_has_expelled = 1 : Expelled or gone: [+ go_c_expelled +]. ?]

[? if go_grade = 1 : The last front page of the year is printed on a hand press: **"We Are Still Here."** ?][? if go_grade = 2 : The last front page of the year: **"The Struggle Goes On."** ?][? if go_grade = 3 : The last front page of the year: **"A Million Workers Behind the Party."** ?][? if go_grade = 4 : The last front page of the year: **"The Party of the German Working Class."** ?]

[? if go_has_record = 1 : **The party's record** ?]

[+ go_record_html +]

- @end_game: End game.

@end_game
title: End game.
go-to: root.start_menu
on-arrival: started = 0
