title: The Red Army's Advice
subtitle: Trotsky's officers offer the party military help.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('m_trotsky'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
RG.lw.fire('m_trotsky');
Q.lw_n = Q.time >= 48 ? 1 : 0;
