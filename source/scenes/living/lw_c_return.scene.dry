title: Home Again
subtitle: A comrade returns from abroad.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_return'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var c = RG.lw.fire('c_return');
RG.lw.setC('cm', c);
var ab = (Q.lw_abroad && Q.lw_abroad[c.id]) || {where: 'abroad'};
Q.lw_where = ab.where;
Q.lw_ret_moscow = ab.where == 'Moscow' ? 1 : 0;
Q.lw_ret_gone = Q[c.faction + '_gone'] ? 1 : 0;
Q.lw_ret_turned = 0;
delete Q.lw_abroad[c.id];
if (Q.lw_ret_gone) {
    RG.expel(c.id, {news: c.name + ' returns, and joins the ' + RG.fname(c.faction)});
} else {
    RG.free(c.id, {news: c.name + ' returns from ' + Q.lw_where});
    // Moscow changes people: some come back with the Executive's line
    if (Q.lw_ret_moscow && Q.moscow_backs && Q.moscow_backs != c.faction && !Q[Q.moscow_backs + '_gone'] && Math.random() < 0.3) {
        RG.setFaction(c.id, Q.moscow_backs);
        Q.lw_ret_turned = 1;
        Q.lw_ret_new = RG.fname(Q.moscow_backs);
    }
}
RG.lw.abroadCount();
RG.lw.setC('cm', RG.comrade(c.id));
!}

= Home Again

**[+ lw_cm_name +]** is back from [+ lw_where +], thinner, with a cheap suitcase full of pamphlets in languages nobody at the Zentrale reads.

[? if lw_ret_gone = 1 : The [+ lw_cm_fname +] have left the party in the meantime, and after a week of meetings, so does [+ lw_cm_name +]. ?][? if lw_ret_turned = 1 : The comrades notice at once that [+ lw_cm_name +] now speaks like the [+ lw_ret_new +]. ?]

- @post: Give [+ lw_cm_name +] a seat in the Zentrale.
- @district: Send [+ lw_cm_name +] back to [+ lw_cm_dname +].
- @gone: Very well.

@post
subtitle: The [+ lw_cm_fname +] are pleased. [? if lw_ret_moscow = 1 : Moscow likes to see its guests promoted. ?]
view-if: lw_ret_gone = 0
on-arrival: {!
var c = RG.comrade(Q.lw_cm);
RG.lw.lean(c.faction, 1, 5);
RG.setRole(Q.lw_cm, 'Member of the Zentrale');
if (Q.lw_ret_moscow) { RG.ecci('all', 3); }
!}

At the first meeting [+ lw_cm_name +] reads out a letter of greeting from [+ lw_where +] that takes twenty minutes.

@district
subtitle: The district gains an organiser and comes closer to the Zentrale.
view-if: lw_ret_gone = 0
on-arrival: {!
var c = RG.comrade(Q.lw_cm);
if (c && c.district) { RG.district(c.district, {loyalty: 8, members: 0.04}); }
!}

@gone
view-if: lw_ret_gone = 1
