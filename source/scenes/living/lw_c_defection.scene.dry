title: A Letter of Resignation
subtitle: A leading comrade is about to leave the party.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_defection'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var c = RG.lw.fire('c_defection');
RG.lw.setC('cm', c);
// where a disappointed comrade goes
if (c.faction == 'ultraleft' && Q.kapd_exists == 1) { Q.lw_where = 'the KAPD'; }
else if (c.faction == 'offensive') { Q.lw_where = 'the left opposition circles outside the party'; }
else if (Q.uspd_exists == 1) { Q.lw_where = 'the USPD'; }
else { Q.lw_where = 'the SPD'; }
!}

= A Letter of Resignation

A letter has arrived at the Zentrale by hand from **[+ lw_cm_name +]** ([+ lw_cm_role +]). It is four pages long and very calm. The party has stopped listening to the [+ lw_cm_fname +], it says, and [+ lw_cm_name +] can no longer defend the line in public. A copy has gone to the press. Everyone knows that [+ lw_where +] would be glad to have the author.

- @post: Offer a post worth staying for.
- @expel: Expel [+ lw_cm_name +] before the letter is printed.
- @release: Let [+ lw_cm_name +] go with dignity.

@post
subtitle: A seat at the table often settles a matter of principle. Our own current will call it a bribe.
on-arrival: {!
if (Math.random() < 0.65) {
    Q.lw_out = 1;
    RG.setRole(Q.lw_cm, RG.pick(['Editor of Die Internationale', 'Member of the Zentrale', 'Head of the trade union department']));
    var c = RG.comrade(Q.lw_cm);
    RG.lw.lean(c.faction, 0, 6);
    Q[Q.leading_faction + '_satisfaction'] -= 4;
} else {
    Q.lw_out = 2;
    RG.expel(Q.lw_cm, {news: Q.lw_cm_name + ' refuses a post and leaves the party', priority: 2});
    RG.ledger(Q.lw_cm_name + ' left the party for ' + Q.lw_where + '.', 'lw_def_' + Q.lw_cm);
    Q.unity -= 3;
}
!}

[? if lw_out = 1 : [+ lw_cm_name +] accepts after a decent interval, and the letter goes into a drawer. ?][? if lw_out = 2 : [+ lw_cm_name +] sends the offer back with one line: "I did not write for a job." ?]

@expel
subtitle: Zinoviev approves. The [+ lw_cm_fname +] will not forget it.
on-arrival: {!
var c = RG.comrade(Q.lw_cm);
RG.expel(Q.lw_cm, {news: 'Zentrale expels ' + Q.lw_cm_name, priority: 2});
RG.ledger('The Zentrale expelled ' + Q.lw_cm_name + '.', 'lw_def_' + Q.lw_cm);
RG.lw.lean(c.faction, -1, -10);
RG.ecci('zinoviev', 5);
!}

The letter, when it appears, reads like the complaint of a man who was thrown out.

@release
subtitle: No hard words. The door stays open, and so does the wound.
on-arrival: {!
var c = RG.comrade(Q.lw_cm);
RG.expel(Q.lw_cm, {news: Q.lw_cm_name + ' leaves the party for ' + Q.lw_where, priority: 2});
RG.ledger(Q.lw_cm_name + ' left the party for ' + Q.lw_where + '.', 'lw_def_' + Q.lw_cm);
RG.lw.lean(c.faction, 0, -3);
Q.unity += 1;
!}

The Zentrale thanks [+ lw_cm_name +] for years of service and regrets the decision. In the districts, members who think the same way keep their cards.
