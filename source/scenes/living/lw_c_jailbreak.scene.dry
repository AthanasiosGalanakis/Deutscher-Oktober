title: A Way Out
subtitle: A plan to free a comrade from prison.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_jailbreak'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var c = RG.lw.fire('c_jailbreak');
RG.lw.setC('cm', c);
Q.lw_name = RG.pick(['the court building in Moabit', 'the prison hospital', 'the railway station on the way to a hearing', 'the gate of the women\'s wing on visiting day']);
!}

= A Way Out

**[+ lw_cm_name +]** has a long time left to serve. The red guard of [+ lw_cm_dname +] has a plan. Next week the prisoner will be taken to [+ lw_name +] under an escort of two guards. A lorry will break down in the road, men in railway workers' overalls will be standing nearby, and the escort will be outnumbered.

There is a second plan, slower and quieter: a warder with debts, who has let it be known that he could leave a door unlocked for the right sum.

- @guards: Let the red guard do it.
- @warder: Pay the warder.
- @wait: Wait. The party does not play at adventures.

@guards
subtitle: Costs 1 fund. A bold stroke. If it fails, there will be shooting, and the police will take revenge.
choose-if: resources >= 1
unavailable-subtitle: We have no funds.
on-arrival: {!
Q.resources -= 1;
if (Math.random() < 0.5 + RG.num(Q.red_guards_loyalty) / 400) {
    Q.lw_out = 1;
    RG.free(Q.lw_cm, {news: 'Armed men free ' + Q.lw_cm_name + ' from police escort', priority: 3});
    Q.repression += 3;
    Q.red_guards_loyalty += 6;
    RG.ledger(Q.lw_cm_name + ' was freed from a police escort by the red guard.', 'lw_jailbreak');
} else {
    Q.lw_out = 2;
    Q.repression += 5;
    Q.red_guards_strength -= 0.5;
    var c = RG.comrade(Q.lw_cm);
    if (c && c.until > 0) { c.until += 6; }
    RG.news('Rescue attempt fails: shooting in ' + Q.lw_cm_dname, 2);
}
RG.lw.lean('offensive', 2, 5);
RG.lw.lean('unionist', -1, -3);
!}

[? if lw_out = 1 : It takes ninety seconds. The escort are left tied up in the lorry, and [+ lw_cm_name +] is on a bicycle, then in a coal barge, then in a safe house in another city. The police poster offers ten thousand marks. ?][? if lw_out = 2 : One of the escort draws his pistol. In the shooting, two of our men are wounded and taken, and the prisoner is driven back to the cells under a guard of twenty. ?]

@warder
subtitle: Costs 2 funds. Quiet and likely. Money spent on a warder is not spent on the movement.
choose-if: resources >= 2
unavailable-subtitle: We do not have the funds.
on-arrival: {!
Q.resources -= 2;
if (Math.random() < 0.7) {
    Q.lw_out = 1;
    RG.free(Q.lw_cm, {news: Q.lw_cm_name + ' escapes from prison', priority: 2});
    Q.repression += 1;
} else {
    Q.lw_out = 2;
    Q.repression += 2;
}
RG.lw.lean('offensive', 1, 2);
!}

[? if lw_out = 1 : On a foggy night, a door is left open and a corridor left empty. [+ lw_cm_name +] walks out in a warder's coat. ?][? if lw_out = 2 : The warder takes the money, and then takes it to the governor. He is promoted. ?]

@wait
subtitle: No risk, no rescue. The cautious are relieved; the red guard is disappointed.
on-arrival: {!
Q.red_guards_loyalty -= 3;
RG.lw.lean('luxemburgist', 1, 2);
RG.lw.lean('unionist', 1, 2);
RG.lw.lean('offensive', 0, -3);
!}

The Zentrale sends word to the red guard: no. [+ lw_cm_name +] will come out by the front gate, by amnesty or at the end of the sentence, and the party will be there to meet the train.
