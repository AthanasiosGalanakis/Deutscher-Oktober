title: In the Dock
subtitle: A comrade stands trial.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_trial'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var c = RG.lw.fire('c_trial');
RG.lw.setC('cm', c);
c.lw_tried = Q.time;
Q.lw_name = RG.pick(['the State Court in Leipzig', 'the regional court in ' + RG.pick(RG.lw.TOWNS[c.district || 'berlin']), 'the special court in Berlin-Moabit']);
!}

= In the Dock

**[+ lw_cm_name +]** is brought up from the cells to face [+ lw_name +] on a charge of preparing high treason. The presiding judge served as a reserve officer in the war, and says so. The public gallery is full of workers who queued since dawn. Our lawyer wants to know what kind of defence the party wants.

- @tribune: Turn the dock into a tribune.
- @legal: Fight the case on the law, point by point.
- @plea: Advise a plea and a promise of good conduct.

@tribune
subtitle: A great speech and a longer sentence. Every worker will read it.
on-arrival: {!
var c = RG.comrade(Q.lw_cm);
if (c && c.until > 0) { c.until += 5; }
Q.worker_support += 4;
RG.news(Q.lw_cm_name + ' in court: "I accuse this Republic"', 2);
!}

[+ lw_cm_name +] speaks for three hours about the war, the murders of January and the officers who were never tried. The judge interrupts eleven times. The speech is sold as a pamphlet the next week.

@legal
subtitle: The prosecution's file is thin. Our lawyer thinks an acquittal is possible, not likely.
on-arrival: {!
if (Math.random() < 0.4) {
    Q.lw_out = 1;
    RG.free(Q.lw_cm, {news: Q.lw_cm_name + ' acquitted', priority: 2});
} else {
    Q.lw_out = 2;
}
!}

[? if lw_out = 1 : The court acquits for lack of evidence, and [+ lw_cm_name +] walks out into the arms of the crowd. ?][? if lw_out = 2 : The court convicts on a lesser count. ?]

@plea
subtitle: Freedom soon, and a stain. The comrade's current is ashamed.
on-arrival: {!
RG.free(Q.lw_cm, {news: Q.lw_cm_name + ' released after a plea'});
var c = RG.comrade(Q.lw_cm);
if (c) { RG.lw.lean(c.faction, -1, -8); }
!}

The lawyer reads a short statement: [+ lw_cm_name +] regrets any words that went too far. The party paper prints the release, and not the statement.
