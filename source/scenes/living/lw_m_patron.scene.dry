title: A Delegation to Moscow
subtitle: A rival current seeks a patron on the Executive.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('m_patron'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var rv = RG.lw.fire('m_patron');
Q.lw_rival = rv;
Q.lw_rival_name = RG.fname(rv);
Q.lw_rival_code = RG.lw.CODE[rv] || 0;
// the man on the Executive who likes that current best, among those who still count
var t = Q.time;
var men = RG.ECCI.filter(function (p) { return !(p == 'lenin' && Q.ecci_lenin_ill); });
men.sort(function (a, b) { return RG.ecciPref(b, rv, t) - RG.ecciPref(a, rv, t); });
Q.lw_patron = men[0];
Q.lw_patron_name = RG.ECCI_NAMES[men[0]];
var s = RG.speaker(rv);
Q.lw_name = s.name;
!}

= A Delegation to Moscow

The Zentrale learns it from a Swedish comrade: a delegation of the **[+ lw_rival_name +]**, led by [+ lw_name +], has been in Moscow for a week. They have been received twice by **[+ lw_patron_name +]**, and have left with him a memorandum on the "crisis of leadership in the German party".

- @counter: Send our own delegation after them.
- @deal: Offer the [+ lw_rival_name +] posts and a say, here in Berlin.
- @ignore: Let them talk. Moscow is far away.

@counter
subtitle: Costs 1 fund. Our case is heard too. The delegation got there first.
choose-if: resources >= 1
unavailable-subtitle: We have no funds.
on-arrival: {!
Q.resources -= 1;
RG.ecci(Q.lw_patron, 5);
RG.ecci('all', 2);
Q.independence -= 2;
if (Math.random() < 0.6) {
    Q.lw_out = 1;
    RG.lw.lean(Q.lw_rival, 0, -4);
} else {
    Q.lw_out = 2;
    RG.lw.lean(Q.lw_rival, 1, 4);
}
!}

[? if lw_out = 1 : [+ lw_patron_name +] receives them too, and in the end declines to take sides "at this stage". The [+ lw_rival_name +] come home with nothing but their travel expenses. ?][? if lw_out = 2 : They are received last, and briefly. [+ lw_patron_name +] has already made up his mind. ?]

@deal
subtitle: Seats on the editorial board buy them off. Our own current feels betrayed.
on-arrival: {!
RG.lw.lean(Q.lw_rival, 1, 9);
Q[Q.leading_faction + '_satisfaction'] -= 6;
Q.unity += 3;
!}

The [+ lw_rival_name +] are offered two seats on the editorial board of the party press and a commission on the party's programme. [+ lw_name +] sends a telegram to Moscow: the delegation is coming home.

@ignore
subtitle: Nothing is lost today. A district on the fence may go over to them.
on-arrival: {!
RG.ecci(Q.lw_patron, -3);
RG.lw.lean(Q.lw_rival, 2, 6);
var ds = Q.districts.filter(function (d) { return Q['district_' + d + '_faction'] != Q.lw_rival && Q['district_' + d + '_loyalty'] < 45; });
if (ds.length && Math.random() < 0.5) {
    var d = RG.pick(ds);
    Q['district_' + d + '_faction'] = Q.lw_rival;
    Q.lw_out = 1;
    Q.lw_d_name = RG.dname(d);
}
RG.news('The ' + Q.lw_rival_name + ' return from Moscow with the Executive\'s blessing', 2);
!}

The delegation comes home with a letter from [+ lw_patron_name +] praising its "revolutionary spirit", and reads it at every meeting it can find. [? if lw_out = 1 : In [+ lw_d_name +], the district conference goes over to the [+ lw_rival_name +]. ?]
