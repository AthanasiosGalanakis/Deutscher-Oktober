title: Words in the Zentrale
subtitle: Two leaders fall out in public.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_quarrel'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var ab = RG.lw.fire('c_quarrel');
RG.lw.setC('cm', ab[0]);
RG.lw.setC('cm2', ab[1]);
Q.lw_name = RG.pick(['the money for the district papers', 'who wrote the last resolution', 'a speech that went too far', 'the line towards the social democrats', 'a report sent to Moscow behind the other\'s back']);
Q.lw_where = RG.pick(['Vienna', 'Moscow', 'Paris']);
!}

= Words in the Zentrale

It started over [+ lw_name +]. Now **[+ lw_cm_name +]** of the [+ lw_cm_fname +] and **[+ lw_cm2_name +]** of the [+ lw_cm2_fname +] speak to each other only through open letters in the party press, and the bourgeois papers reprint both.

- @backa: Back [+ lw_cm_name +].
- @backb: Back [+ lw_cm2_name +].
- @send: Send [+ lw_cm2_name +] abroad for a while.

@backa
subtitle: The [+ lw_cm_fname +] are pleased, and the [+ lw_cm2_fname +] are not.
on-arrival: {!
var a = RG.comrade(Q.lw_cm), b = RG.comrade(Q.lw_cm2);
RG.lw.lean(a.faction, 1, 7);
RG.lw.lean(b.faction, 0, -7);
!}

The Zentrale finds that [+ lw_cm_name +] acted in the interests of the party.

@backb
subtitle: The [+ lw_cm2_fname +] are pleased, and the [+ lw_cm_fname +] are not.
on-arrival: {!
var a = RG.comrade(Q.lw_cm), b = RG.comrade(Q.lw_cm2);
RG.lw.lean(b.faction, 1, 7);
RG.lw.lean(a.faction, 0, -7);
!}

The Zentrale finds that [+ lw_cm2_name +] acted in the interests of the party. [+ lw_cm_name +] calls it a factional verdict, which it is.

@send
subtitle: A few months in [+ lw_where +] will cool tempers. The [+ lw_cm2_fname +] will call it exile.
on-arrival: {!
var b = RG.comrade(Q.lw_cm2);
RG.lw.sendAbroad(Q.lw_cm2, RG.lw.rnd(3, 5), Q.lw_where);
Q.unity += 3;
RG.lw.lean(b.faction, 0, -5);
!}

[+ lw_cm2_name +] is given an important mission in [+ lw_where +], the Zentrale insists. [+ lw_cm_name +] does not come to the station.
