title: An Amnesty Bill
subtitle: Parliament debates an amnesty for political prisoners.
new-page: true
tags: event
priority: -1
view-if: {!
if (typeof RG === 'undefined') { return false; }
if (!RG.lw && this.game.scenes.lw_lib) { this._runActions(this.game.scenes.lw_lib.onArrival); }
return !!(RG.lw && RG.lw.ready('c_amnesty'));
!}
on-arrival: {!
if (!RG.lw) { this._runActions(this.game.scenes.lw_lib.onArrival); }
var cs = RG.lw.fire('c_amnesty') || [];
Q.lw_n = cs.length;
Q.lw_name = cs.map(function (c) { return c.name; }).join(', ').replace(/, ([^,]*)$/, ' and $1');
Q.lw_amnesty_ids = cs.map(function (c) { return c.id; });
!}

= An Amnesty Bill

The government has put an amnesty bill before parliament, "to close the wounds of the revolutionary years". It would free [+ lw_name +], and hundreds of rank-and-file comrades held since the fighting. It would also free the Freikorps officers convicted for the putsches, and the nationalist parties will vote for it with both hands.

- @for: Support the bill as it stands.
- @amend: Demand that it exclude the putschists, or nothing.

@for
subtitle: Our comrades come home, and so do the officers who shot workers.
on-arrival: {!
var ids = Q.lw_amnesty_ids || [];
for (var i = 0; i < ids.length; i++) { RG.free(ids[i], {quiet: true}); }
RG.news('Amnesty law passes: ' + Q.lw_name + ' released', 3);
RG.ledger('An amnesty freed ' + Q.lw_name + ', and the putschists with them.', 'lw_amnesty');
Q.freikorps_strength += 2;
Q.offensive_satisfaction -= 4;
!}

At the prison gates our comrades come out to a band. A few days later, at another gate, a former Freikorps captain comes out to a car and flowers of his own.

@amend
subtitle: The social democrats might be shamed into voting with us. If not, the bill falls and our comrades stay inside.
on-arrival: {!
Q.worker_support += 2;
if (Math.random() < 0.35) {
    Q.lw_out = 1;
    var ids = Q.lw_amnesty_ids || [];
    for (var i = 0; i < ids.length; i++) { RG.free(ids[i], {quiet: true}); }
    RG.news('Amnesty for workers, not for putschists: ' + Q.lw_name + ' free', 3);
    RG.ledger('An amnesty freed ' + Q.lw_name + ', and the putschists stayed in prison.', 'lw_amnesty');
} else {
    Q.lw_out = 2;
    RG.news('Amnesty bill falls');
}
RG.lw.lean('luxemburgist', 2, 5);
!}

[? if lw_out = 1 : The social democrats, embarrassed before their own workers, vote for our amendment. The putschists stay inside. ?][? if lw_out = 2 : The amendment fails, and the bill fails with it. ?]
