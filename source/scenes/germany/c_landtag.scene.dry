title: A State Election
new-page: true
view-if: crisis = 0 and congress = 0 and c_landtag_timer <= 0 and time >= 14 and c_landtag_left > 0
on-arrival: {!
Q.c_landtag_timer = 6;
Q.month_actions += 1;
// the smaller states, each of which votes once in these years; Prussia and
// Saxony have their own events
var names = {thuringia: 'Thuringia', hamburg: 'Hamburg', bremen: 'Bremen', bavaria: 'Bavaria'};
var done = (Q.c_landtag_done && typeof Q.c_landtag_done === 'object') ? Q.c_landtag_done : {};
var open = Object.keys(names).filter(function (s) { return !done[s]; });
var s = open.length ? RG.pick(open) : 'thuringia';
Q.c_landtag_state = s;
Q.c_landtag_state_name = names[s];
Q.c_landtag_bavaria = s == 'bavaria' ? 1 : 0;
Q.c_landtag_won = 0;
!}
frequency: 200
is-card: true
tags: germany

= A State Election

**[+ c_landtag_state_name +]** votes for a new parliament. The states run the police, the schools and the courts, and a state government can make the party's life easy or impossible. [? if c_landtag_bavaria = 1 : In Bavaria the right has held power since the council republic was crushed. ?][? if c_landtag_bavaria = 0 : Here the workers' parties together might have a majority. ?]

- @stand: Stand our own list.
- @boycott: Boycott the vote and campaign for councils.
- @easy_discard

@stand
subtitle: [? if lock_elections = 1 : Against the party line: costs Unity. ?] Our result will depend on our members there, and on the mood of the workers.
choose-if: lock_elections < 2
unavailable-subtitle: The [+ leading_faction_adj +] line forbids taking part in bourgeois elections.
on-arrival: {!
if (Q.lock_elections == 1) {
    Q.unity -= 10;
    Q[Q.leading_faction + '_satisfaction'] -= 10;
}
if (!Q.c_landtag_done || typeof Q.c_landtag_done !== 'object') { Q.c_landtag_done = {}; }
Q.c_landtag_done[Q.c_landtag_state] = 1;
Q.c_landtag_left = 4 - Object.keys(Q.c_landtag_done).length;
RG.election(Q.c_landtag_state);
Q.c_landtag_won = Q.election_kpd_seats;
Q.c_landtag_majority = (Q.election_left_majority == 1 && Q.c_landtag_bavaria == 0) ? 1 : 0;
!}

The party wins [+ election_kpd_share_display +] per cent of the vote and [+ election_kpd_seats +] seats. [? if c_landtag_majority = 1 : With the social democrats, the workers' parties have a majority, and the SPD wants to know whether our deputies will vote for its government. ?]

- @tolerate: Vote for a socialist government, on conditions.
- @oppose: Stay in opposition.
- @done: Very well.

@tolerate
subtitle: [? if lock_united_front = 1 : Against the party line: costs Unity. ?] A friendly state government. The police there will leave us alone.
view-if: c_landtag_majority = 1
choose-if: lock_united_front < 2
unavailable-subtitle: The [+ leading_faction_adj +] line forbids any deal with the social democrats.
on-arrival: {!
if (Q.lock_united_front == 1) {
    Q.unity -= 10;
    Q[Q.leading_faction + '_satisfaction'] -= 10;
}
RG.district(Q.c_landtag_state, {repression: -15, loyalty: 4});
Q.spd_relation += 5;
Q.lean_unionist += 2;
!}

Our votes elect a social democratic government that promises to purge the police and disarm the civil guards. It does some of it.

@oppose
subtitle: Our deputies keep clean hands.
view-if: c_landtag_majority = 1
on-arrival: lean_offensive += 1

Our deputies vote against every budget, and the SPD governs with the Democrats instead.

@done
view-if: c_landtag_majority = 0

The new deputies take their seats on the far left of the chamber.

@boycott
subtitle: No seats. The workers mostly vote anyway.
on-arrival: {!
if (!Q.c_landtag_done || typeof Q.c_landtag_done !== 'object') { Q.c_landtag_done = {}; }
Q.c_landtag_done[Q.c_landtag_state] = 1;
Q.c_landtag_left = 4 - Object.keys(Q.c_landtag_done).length;
if (!Q.ultraleft_gone) {
    Q.ultraleft_satisfaction += 6;
    Q.lean_ultraleft += 2;
} else {
    Q.lean_offensive += 1;
}
!}

Our posters call on the workers to elect councils, not deputies. The turnout in the workers' districts is barely lower than last time.
