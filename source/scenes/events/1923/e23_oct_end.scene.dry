title: The Decision
subtitle: After two weeks of fighting, the reports from the districts are in.
new-page: true
tags: event
view-if: crisis_october = 1 and e23_rising_phase = 1 and e23_battle_done = 1 and e23_october_done = 0 and (e23_oct_fight >= 2 or e23_oct_alive = 0 or crisis_time >= e23_oct_end_time)
max-visits: 1
priority: 4
on-arrival: {!
if (!RG.e22) { this._runActions(this.game.scenes.e22_lib.onArrival); }
RG.e22.octTick(Q.crisis_time);
var held = Q.e23_oct_rising || [];
var has = function (d) { return held.indexOf(d) >= 0; };
var r;
if (has('berlin') && held.length >= 4 && Q.army_loyalty < 50) {
    r = 1;
} else if (has('saxony') || has('thuringia') || has('halle')) {
    r = 2; Q.e23_red_region = 1;
} else if (has('ruhr')) {
    r = 2; Q.e23_red_region = 2;
} else if (has('hamburg') || has('bremen')) {
    r = 2; Q.e23_red_region = 3;
} else if (Q.e23_oct_arms < 2 && Q.spd_relation < 20 && Q.army_loyalty >= 55) {
    r = 4;
} else {
    r = 3;
}
Q.e23_oct_result = r;
Q.german_october = r == 1 ? 3 : 2;
Q.e23_oct_martyr_ok = 0;
if (Q.directive_active && Q.directive_id == 'october') {
    RG.directiveResolve(r <= 2 ? 'success' : 'partial');
    Q.directive_reckoning = 0;
}
Q.e23_oct_verdict = r <= 2 ? 3 : 2;
if (r == 1) {
    RG.ecci('all', 15);
    Q.districts.forEach(function (d) { RG.district(d, {repression: -30, militancy: 8}); });
    RG.news('Councils take power: Seeckt leaves Berlin', 3);
    RG.ledger('The German October won: the councils took Berlin.', 'e23_won');
} else if (r == 2) {
    RG.ecci('trotsky', 8);
    var red = {1: ['saxony', 'thuringia'], 2: ['ruhr'], 3: ['hamburg', 'bremen']}[Q.e23_red_region];
    Q.districts.forEach(function (d) {
        RG.district(d, red.indexOf(d) >= 0 ? {repression: -25, guards: 2, loyalty: 8} : {repression: 15});
    });
    Q.e23_red_names = RG.e22.list(red);
    RG.news('Councils hold ' + Q.e23_red_names + ' against the Reichswehr', 3);
} else {
    RG.ecci('trotsky', -10);
    RG.ecci('zinoviev', -6);
    Q.e22_workers_gov = 0;
    Q.e23_seeckt_ambition = Math.random() < 0.3 ? 1 : 0;
    Q.districts.forEach(function (d) {
        RG.district(d, {repression: 8, guards: -Q['district_' + d + '_guards'] * 0.5});
        if (Q['district_' + d + '_strike']) { RG.endStrike(d, 'crushed'); }
    });
    RG.news('The rising is crushed: thousands arrested', 3);
}
RG.e22.octClear();
!}

= The Decision

[? if e23_oct_result = 1 : It started in a barracks in Spandau and went down the railway lines. Battalions elected councils and locked their officers in. On the ninth day General von Seeckt left Berlin for Pomerania with the officers who would follow him. The councils hold [+ e23_oct_held_names +]. ?]

[? if e23_oct_result = 2 : Berlin did not fall. [+ e23_red_names +] did not fall either. The Reichswehr is short of reliable battalions, and it has stopped attacking. ?][? if e23_oct_result = 2 and e23_red_region = 1 : The hundreds hold the line of the Erzgebirge and the Thuringian Forest, and the councils govern from Chemnitz to Gera. ?][? if e23_oct_result = 2 and e23_red_region = 2 : The councils govern the pits from Duisburg to Dortmund, between French bayonets and German ones. ?][? if e23_oct_result = 2 and e23_red_region = 3 : The harbour is closed to the Reichswehr's transports, and the sailors in Kiel have elected their own committee. ?]

[? if e23_oct_result = 3 and e23_oct_has_fallen = 1 : [+ e23_oct_fallen_names +] fell first. ?][? if e23_oct_result = 3 : The rising is beaten. The strike broke where the SPD called its members back to work, and the hundreds were driven out of the stations and the town halls one by one. Thousands are under arrest. ?]

[? if e23_oct_result = 4 : It was a massacre. The strike never became general, the soldiers fired, and the hundreds ran out of ammunition on the second day. The Black Reichswehr is going from district to district with lists taken from our couriers. ?]

- @proclaim: Proclaim the German Socialist Soviet Republic.
- @hold_region: Hold the red region and build a council republic inside it.
- @negotiate: Give up the region in return for an amnesty.
- @underground: Bury the rifles and go underground.
- @last_stand: Fight on in the workers' districts.
- @crushed: See how it ends.

@proclaim
view-if: e23_oct_result = 1
on-arrival: {!
Q.ending_id = 1;
!}
go-to: game_over

@hold_region
subtitle: The council republic lives, under siege.
view-if: e23_oct_result = 2
on-arrival: {!
RG.ledger('The councils held ' + Q.e23_red_names + ' against the Reichswehr.', 'e23_region');
Q.ending_id = 2;
!}
go-to: game_over

@negotiate
subtitle: Nobody else dies. The party stays legal and the hundreds lose their rifles.
view-if: e23_oct_result = 2
on-arrival: {!
Q.e23_red_region = 0;
RG.ledger('The councils gave up ' + Q.e23_red_names + ' in return for an amnesty.', 'e23_amnesty');
Q.repression += 10;
Q.red_guards_strength *= 0.5;
Q.districts.forEach(function (d) { Q['district_' + d + '_members'] *= 0.9; });
Q.offensive_satisfaction -= 8;
!}

Stresemann signs the amnesty and two Social Democratic ministers witness it. Seeckt calls it treason. The hundreds hand in their rifles at the town halls and go home.

@underground
subtitle: Many members are lost. The organisation survives.
view-if: e23_oct_result = 3
on-arrival: {!
var arr = ['meyer', 'pieck', 'eberlein', 'walcher', 'maslow', 'thalheimer'].filter(function (c) { return RG.isFree(c); }).slice(0, 3);
Q.e23_oct_arrests = arr.map(function (c) { return RG.comradeName(c); }).join(', ');
Q.e23_oct_has_arrests = arr.length ? 1 : 0;
arr.forEach(function (c) { RG.arrest(c, 9, {quiet: true}); });
if (arr.length) { RG.news(Q.e23_oct_arrests + ' arrested', 2); }
Q.repression += 20;
Q.red_guards_strength *= 0.3;
Q.districts.forEach(function (d) { Q['district_' + d + '_members'] *= 0.65; });
!}

The order goes out to bury the rifles, burn the membership lists and scatter. [? if e23_oct_has_arrests = 1 : The police move faster than the couriers, and [+ e23_oct_arrests +] are taken in the first week. ?] By Christmas the party has lost a third of its members.

@last_stand
subtitle: Very few will survive it, and the party will remember them.
view-if: e23_oct_result = 3
on-arrival: {!
var fall = ['thalmann', 'maslow', 'frolich', 'eberlein'].filter(function (c) { return RG.isFree(c); })[0] || 0;
Q.e23_oct_martyr = fall ? RG.comradeName(fall) : 0;
Q.e23_oct_martyr_ok = fall ? 1 : 0;
if (fall) {
    RG.kill(fall, {news: RG.comradeName(fall) + ' killed on the barricades'});
    RG.ledger(RG.comradeName(fall) + ' was killed on the barricades of the German October.', 'e23_fallen');
}
Q.repression += 30;
Q.red_guards_strength *= 0.1;
Q.militancy += 10;
Q.districts.forEach(function (d) { Q['district_' + d + '_members'] *= 0.5; });
!}

The barricades in Wedding, Barmbek and the Chemnitz suburbs hold for a week. [? if e23_oct_martyr_ok = 1 : [+ e23_oct_martyr +] is killed on the last of them. ?] The Reichswehr shoots the prisoners it does not need.

@crushed
view-if: e23_oct_result = 4
on-arrival: {!
Q.districts.forEach(function (d) { Q['district_' + d + '_members'] = 0.1; });
Q.members = 0.8;
Q.members_display = '0.8';
Q.kpd_banned = 1;
Q.ending_id = 4;
!}
go-to: game_over
