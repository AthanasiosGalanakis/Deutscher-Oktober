title: Levi Was Wrong
subtitle: The action he feared has won.
new-page: true
tags: event
view-if: year = 1921 and month >= 4 and crisis = 0 and levi_in_party = 1 and march_action = 2 and e21_central_done = 1 and e21_after_done = 0
max-visits: 1
