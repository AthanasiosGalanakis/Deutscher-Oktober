on-arrival: {!
if (Q.comintern_member == 1) {
    RG.directive({
        id: 'livorno',
        title: 'Approve the split at Livorno',
        text: 'The Executive requires the German section to approve the action of its envoys at Livorno, to condemn Serrati and his centrists in its press, and to draw the lesson for its own ranks.',
        from: 'zinoviev',
        months: 2,
        goals: [{q: 'independence', op: '<=', v: Math.max(20, Math.round(Q.independence - 8))}],
