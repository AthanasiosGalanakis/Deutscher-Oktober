title: 1920 setup
view-if: e20_init_done = 0
tags: event
priority: 100
max-visits: 1
on-arrival: {!
Q.e20_init_done = 1;
// only set what is not set yet, so test presets are not overwritten
var start = {
    // shared flags set in 1920 (see the writing guide)
    kapp_outcome: 0, ruhr_red_army: 0, warsaw_outcome: 0,
    twenty_one_conditions: 0, uspd_split: 0, vkpd_formed: 0,
    // the Kapp Putsch: the general strike, district by district
    kapp_started: 0, crisis_kapp: 0, kapp_decided: 0,
    kapp_statement: 0, kapp_armed: 0, kapp_junta_fell: 0,
    e20_kapp_voice: 0, e20_kapp_demands: 0, e20_kapp_army: 0,
    e20_kapp_back: 0, e20_kapp_back_names: 0,
    e20_kapp_target: 0, e20_kapp_target_name: 0, e20_kapp_target_out: 0,
    e20_kapp_committee_done: 0, e20_kapp_arms_done: 0, e20_kapp_recanted: 0,
    e20_wg_score: 0, wg_stance: 0, kpd_in_government: 0,
    // the Ruhr Red Army: men and towns against Watter's troops
    crisis_ruhr: 0, e20_ruhr_extra: 0, e20_ruhr_towns: 0, e20_ruhr_men: 0, e20_ruhr_watter: 0,
    e20_ruhr_final: 0, e20_ruhr_hagen: 0, e20_ruhr_dug: 0, e20_wesel: 0,
    e20_ruhr_front_done: 0, e20_ruhr_solidarity_done: 0, e20_ruhr_council_done: 0,
    bielefeld: 0, ruhr_peaceful: 0, ruhr_soviet: 0,
    // the Bavarian council republic, if it survived 1919
    bavaria_1920_fate: 0, bav_strength: 0, bav_settled: 0, bav_surrendered: 0,
    // the Left Radicals and the KAPD
    kapd_members: 0, kapd_sympathiser: 0, ultraleft_crisis_1920: 0,
    e20_ul_power: 0, e20_ul_won: 0, e20_split_lost: 0,
    // the year's other decisions
    massacre_response: 0, works_councils_line: 0,
    election_bonus: 0, e20_campaign: 0, e20_election_done: 0, e20_kpd_seats_display: 0, e20_wg_survives: 0,
    warsaw_bonus: 0, border_rising: 0, e20_rising_strength: 0, e20_rising_held: 0,
    uspd_score: 0, congress_done: 0, halle_done: 0, e20_attacked: 0, e20_halle_bonus: 0,
    e20_uspd_ministers_left: 0, e20_bread: 0,
    e20_lead_ul: 0, e20_lux_in: 1,
    // the unification congress
    e20_newcomers: 0, e20_lead_choice: 0, e20_left_government: 0, e20_members_display: 0,
    e20_slate: 0, e20_slate_won: 0, e20_unif_whole: 0, e20_unif_added: 0, e20_unif_add: 0,
    e20_daumig_deal: 0, e20_cg_daumig_done: 0, e20_levi_free: 0,
    // Moscow's directives
    e20_polish_dir: 0, e20_cond_dir: 0, e20_halle_won: 0,
    // Hoelz, the strike committee and the quarrel on the Executive
    e20_hoelz_line: 0, e20_hoelz_caught: 0,
    e20_committee_line: 0, e20_committee_d: 0, e20_committee_name: 0, e20_committee_trade: 0, e20_committee_ours: 0,
    e20_committee_faction: 0, e20_committee_nb: 0, e20_committee_nb_name: 0, e20_committee_rep: 0, e20_committee_ok: 0,
    e20_quarrel_line: 0, e20_quarrel_zin_ahead: 0
};
for (var k in start) {
    if (Q[k] === undefined) {
        Q[k] = start[k];
    }
}
!}
go-to: post_event
