on-arrival: {!
Q.e20_cond_dir = 0;
if (Q.comintern_member == 1 && Q.twenty_one_conditions != 3) {
    Q.e20_cond_dir = 1;
    RG.directive({id: 'conditions21', title: 'The Twenty-One Conditions',
        text: 'Carry the conditions of the International into the USPD at Halle. Break with the reformists and the centrists, and place the party\'s press and its deputies under the discipline of the International.',
        from: 'zinoviev', months: 3,
        goals: [{q: 'e20_halle_won', op: '>=', v: 1}, {q: 'independence', op: '<=', v: 45}],
