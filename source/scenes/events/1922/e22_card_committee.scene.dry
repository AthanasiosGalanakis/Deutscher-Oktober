title: The Defence Committee
subtitle: The joint committee formed after Rathenau's murder still meets.
new-page: true
view-if: crisis = 0 and congress = 0 and e22_rathenau_front = 1 and year = 1922 and month >= 7
on-arrival: {!
Q.month_actions += 1;
RG.target('militancy');
Q.e22_cm_d = Q.sys_target;
