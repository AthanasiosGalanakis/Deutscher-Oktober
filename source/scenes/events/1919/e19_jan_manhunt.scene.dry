title: 15 January
subtitle: Soldiers and citizens' guards hunt the Spartacist leaders.
new-page: true
tags: event
view-if: crisis_january = 1 and crisis_time >= 3
max-visits: 1
on-arrival: {!
if (Q.january_outcome == 0) { Q.january_outcome = 1; }
var base = Q.e19_hide == 2 ? -100 : [70, 40][Q.e19_hide] + (Q.e19_seen ? 15 : 0) + (Q.january_outcome == 1 ? 5 : 0);
var luxLives = Math.random() * 100 >= base;
var liebLives = Math.random() * 100 >= base + (Q.e19_lieb_committee ? 20 : 0);
if (!luxLives && !liebLives) {
    RG.kill('luxemburg', {quiet: true});
    RG.kill('liebknecht', {quiet: true});
    RG.news('Luxemburg and Liebknecht murdered by officers in Berlin', 3);
    RG.ledger('Rosa Luxemburg and Karl Liebknecht were murdered on 15 January 1919.', 'e19_murders');
} else if (!luxLives) {
    RG.kill('luxemburg', {news: 'Rosa Luxemburg murdered by officers of the Eden Hotel', priority: 3});
    RG.ledger('Rosa Luxemburg was murdered on 15 January 1919. Liebknecht escaped.', 'e19_murders');
} else if (!liebLives) {
    RG.kill('liebknecht', {news: 'Karl Liebknecht shot in the Tiergarten', priority: 3});
    RG.ledger('Rosa Luxemburg escaped the manhunt of January 1919.', 'e19_murders');
} else {
    RG.news('Luxemburg and Liebknecht escape the manhunt', 3);
    RG.ledger('Rosa Luxemburg and Karl Liebknecht both escaped the manhunt of January 1919.', 'e19_murders');
}
Q.luxemburg_alive = luxLives ? 1 : 0;
Q.liebknecht_alive = liebLives ? 1 : 0;
Q.luxemburg_advisor = Q.luxemburg_alive;
Q.liebknecht_advisor = Q.liebknecht_alive;
Q.leaders_hidden = Q.e19_hide >= 1 ? 1 : 0;
if (!luxLives) { Q.luxemburgist_satisfaction -= 10; Q.unity -= 5; }
if (!liebLives) { Q.militancy += 5; }
if (!luxLives && !liebLives) { Q.spd_relation -= 15; Q.worker_support += 3; }
Q.party_chair = Q.luxemburg_alive ? 'Rosa Luxemburg' : 'Leo Jogiches';
Q.spartacist_uprising_done = 1;
RG.districtSync();
RG.endStrike('berlin', Q.january_outcome == 1 ? 'crushed' : 'quiet');
RG.district('berlin', {repression: 12, loyalty: Q.january_outcome == 1 ? -5 : 0});
if (Q.e19_buried) { RG.district('berlin', {guards: 0.5}); }
Q.crisis = 0;
Q.crisis_january = 0;
Q.crisis_name = 0;
Q.crisis_goal = 0;
Q.crisis_line_1 = 0;
Q.crisis_line_2 = 0;
Q.crisis_line_3 = 0;
Q.crisis_momentum_label = 0;
!}

= 15 January 1919

[? if e19_hide = 0 : Luxemburg and Liebknecht spent the last days moving between flats of friends the police already knew. ?][? if e19_hide = 1 : For a week they moved every second night between the flats we found for them. ?][? if e19_hide = 2 : They were already out of Berlin, in Frankfurt, among comrades nobody had thought to watch. ?]

[? if luxemburg_alive = 0 and liebknecht_alive = 0 : On the evening of the 15th a citizens' guard found them in a flat in Wilmersdorf and took them to the Eden Hotel, the headquarters of the Guards Cavalry Rifle Division. On Captain Pabst's orders Liebknecht was driven into the Tiergarten and shot "while trying to escape". Luxemburg was clubbed with a rifle butt and shot in the car, and her body was thrown into the Landwehr Canal. The government says she was killed by an angry crowd. ?][? if luxemburg_alive = 1 and liebknecht_alive = 0 : Liebknecht was caught in Wilmersdorf, taken to the Eden Hotel and shot in the Tiergarten "while trying to escape". The soldiers who came for Luxemburg found an empty room. ?][? if luxemburg_alive = 0 and liebknecht_alive = 1 : Luxemburg was caught, taken to the Eden Hotel and murdered by officers of the Guards Cavalry Rifle Division. Her body was thrown into the Landwehr Canal. Liebknecht got away. ?][? if luxemburg_alive = 1 and liebknecht_alive = 1 : The officers who came for them found a cold stove and an unmade bed. Captain Pabst's men are still searching. ?]

[? if january_outcome = 1 : The rising is crushed. More than a hundred and fifty of its defenders are dead. ?][? if january_outcome = 2 : The rising is lost, but most of its fighters are alive, and so are their rifles. ?] Luxemburg's last article, printed on the 14th, was called "Order Prevails in Berlin".
