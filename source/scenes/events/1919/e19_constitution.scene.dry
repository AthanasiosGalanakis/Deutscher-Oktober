if (Q.lock_union_work == 1) { Q.unity -= 10; Q[Q.leading_faction + '_satisfaction'] -= 10; }
Q.e19_council_lists = 1;
Q.lean_unionist += 2;
Q.ultraleft_satisfaction -= 4;
!}

