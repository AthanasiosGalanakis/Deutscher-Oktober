title: The First of May in Munich
subtitle: Von Oven's troops attack.
new-page: true
tags: event
view-if: crisis_bavaria = 1 and crisis_time >= 1 and (e19_bav_whites <= 7 or crisis_time >= 6)
max-visits: 1
priority: 4
on-arrival: {!
var army = Q.e19_bav_army * (Q.e19_bav_trained ? 1.3 : 1) + (Q.bav_solidarity ? 6 : 0) + (Q.bav_peasants >= 1 ? 3 : 0);
var fed = Q.e19_bav_food > 0 || Q.bav_peasants >= 2;
Q.e19_bav_score = Math.round(army);
if (army >= 24 && fed && Q.bav_power != 2 && Q.bav_negotiated == 0) {
    Q.bav_result = 3;
    Q.bavaria_soviet = 2;
    Q.district_bavaria_members += 3;
    Q.district_bavaria_loyalty += 20;
    Q.world_revolution += 8;
    Q.stability -= 8;
    Q.levine_alive = 1;
} else if (Q.bav_negotiated == 1) {
    Q.bav_result = 2;
    Q.bavaria_soviet = 1;
    Q.district_bavaria_members *= 0.8;
} else {
    Q.bav_result = 1;
    Q.bavaria_soviet = 1;
    Q.district_bavaria_members *= (Q.bav_power == 2) ? 0.7 : 0.5;
    Q.district_bavaria_loyalty -= 10;
    Q.freikorps_strength += 20;
    Q.civil_guards_strength += 40;
}
Q.crisis = 0;
Q.crisis_bavaria = 0;
Q.crisis_name = 0;
Q.crisis_goal = 0;
Q.crisis_line_1 = 0;
Q.crisis_line_2 = 0;
Q.crisis_line_3 = 0;
Q.crisis_momentum_label = 0;
RG.districtSync();
if (Q.bav_result == 3) {
    RG.news('Truce of Freising: the Bavarian Soviet Republic survives', 3);
    RG.district('bavaria', {guards: 3, militancy: 6});
} else if (Q.bav_result == 2) {
    RG.news('Munich surrenders: the Red Army lays down its arms', 3);
    RG.district('bavaria', {repression: 12});
} else {
    RG.news('White terror in Munich: hundreds shot as the council republic falls', 3);
    RG.district('bavaria', {repression: Q.bav_hostages ? 30 : 22, guards: -1, loyalty: -5});
    RG.ledger('The Bavarian Council Republic was drowned in blood in May 1919.', 'e19_munich_terror');
}
!}

= The First of May in Munich

[? if bav_result = 1 and bav_hostages = 1 : On 30 April, in the yard of the Luitpold Gymnasium, Red Army men shot ten of their hostages. The Whites have the atrocity they wanted. ?][? if bav_result = 1 : On 1 May von Oven's troops broke into Munich. For three days they hunted the Reds through Giesing and Schwabing. Gustav Landauer was beaten to death in the yard of Stadelheim prison. Fifty-three Russian prisoners of war were shot at Gräfelfing, and a party of Catholic journeymen, taken for Spartacists, in the Karolinenplatz. More than six hundred people are dead. ?][? if bav_result = 1 and bav_power = 2 : Our party never sat in the Executive. It changes little in Stadelheim. ?]

[? if bav_result = 2 : On 1 May, after two days of talks, von Oven's troops march into Munich. The Red Army hands in its rifles at the barracks. There are arrests and beatings in the cellars, but no massacre. ?]

[? if bav_result = 3 : On 1 May the Whites attack and are thrown back at the Isar bridges and at Dachau. The peace terms are due at Versailles any day, and Berlin will not pay for a siege of Bavaria's capital. On 4 May, at Freising, the generals sign a truce. **A Bavarian Soviet Republic survives** in Munich and the south, ringed by enemies and short of everything. ?]
